# Файлы настроек (кроме примеров)
config.yaml
config.json
secrets/
.env
!*.example
!*.sample

# Папки проекта (которые создаются автоматически)
__pycache__/
migrations/__pycache__/
*.pyc

# Миграции БД (НЕ исключаем - они важны!)
